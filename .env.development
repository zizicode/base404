# =====================================================================
# .env.development — variables locales. NO commitear con valores reales.
# Cargado por: tsx watch --env-file=.env.development src/app.ts
# =====================================================================

NODE_ENV=development
PORT=3000

# Supabase (proyecto de desarrollo/staging, NUNCA el de producción)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme_service_role_key
SUPABASE_ANON_KEY=changeme_anon_key

# CORS: separado por comas si son varios orígenes
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=debug
