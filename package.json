{
  "name": "error-codes-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/app.ts",
    "start": "tsx --env-file=.env.production src/app.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp && pnpm run type-check && pnpm run lint",
    "generate:api": "orval",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@supabase/supabase-js": "^2.110.1",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "orval": "^8.20.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0"
  }
}
