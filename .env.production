# =====================================================================
# .env.production — plantilla. En el servidor real, estas variables
# deben inyectarse desde el proveedor (Railway/Fly/Render/VPS secrets),
# NO desde este archivo committeado. Mantenlo solo como referencia de
# qué claves existen, sin valores reales.
# Cargado por: tsx --env-file=.env.production src/app.ts
# =====================================================================

NODE_ENV=production
PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

CORS_ORIGIN=https://tu-dominio.com

LOG_LEVEL=info
